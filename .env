# MongoDB connection string (default: mongodb://localhost:27017)
MONGODB_URI=mongodb://localhost:27017

# Server port (default: 3001)
PORT=3001

# Default user ID when no X-User-Id header is sent (no auth yet)
# Use a valid 24-char hex ObjectId
DEFAULT_USER_ID=000000000000000000000001

# Optional: restrict CORS to a single origin (e.g. http://localhost:8081)
# If unset, all origins are allowed (fine for local dev)
# ALLOWED_ORIGIN=http://localhost:8081

# Optional: log level (default: info)
# RUST_LOG=info
